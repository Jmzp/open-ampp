# Generado por OPEN_AMPP: se sobrescribe en cada inicio.
[mysqld]
basedir="{{basedir}}"
datadir="{{datadir}}"
port={{port}}
bind-address=127.0.0.1
{{socket_line}}
pid-file="{{run_dir}}/mariadb.pid"
log-error="{{log_dir}}/mariadb.log"
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

[client]
port={{port}}
{{socket_line}}
