# Generated by Open AMPP: rewritten on every start.
[mysqld]
basedir="{{basedir}}"
datadir="{{datadir}}"
port={{port}}
bind-address=127.0.0.1
{{socket_line}}
# MariaDB's own PID file lives apart: Open AMPP uses run/mariadb.pid.
pid-file="{{run_dir}}/mariadbd.pid"
log-error="{{log_dir}}/mariadb.log"
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

[client]
port={{port}}
{{socket_line}}
