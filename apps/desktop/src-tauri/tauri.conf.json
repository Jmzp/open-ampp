{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open AMPP",
  "version": "0.1.1",
  "identifier": "dev.openampp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open AMPP",
        "width": 1100,
        "height": 720,
        "label": "main",
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Apache, MariaDB y PHP para desarrollo local",
    "longDescription": "Open AMPP levanta Apache, MariaDB y PHP (varias versiones) para desarrollo local, con una app de escritorio y el comando ampp.",
    "homepage": "https://github.com/Jmzp/open-ampp",
    "license": "MIT",
    "publisher": "Open AMPP",
    "copyright": "© Open AMPP",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGRUQyNUNEM0VGQjIyNUMKUldSY0l2cyt6U1h0SDBYcGIrUEZGL05qcE9jcmRyWkpua2diNXlERDQvZ2EyUWNEaHRqSHZzUmUK",
      "endpoints": [
        "https://github.com/Jmzp/open-ampp/releases/latest/download/latest.json"
      ]
    }
  }
}
